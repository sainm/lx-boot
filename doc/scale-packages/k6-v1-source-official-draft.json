  "resultRules": [
    {
      "ruleCode": "K6_BELOW_CUTOFF",
      "riskLevel": "NORMAL",
      "scoreMin": 0,
      "scoreMax": 12,
      "scoreSource": "RAW_SCORE",
      "translations": {
        "zh-CN": {
          "resultTitle": "未达到筛查切点",
          "resultDescription": "总分为0–12。该结果仅表示未达到本包采用的筛查切点，不等同于没有心理困扰，也不是临床诊断。",
          "suggestionText": "如果仍感到困扰，请结合专业人员访谈和其他信息评估。",
          "reviewStatus": "DRAFT"
        },
        "ja-JP": {
          "resultTitle": "スクリーニングカットオフ未満",
          "resultDescription": "合計得点は0～12です。この結果は本パッケージのスクリーニングカットオフ未満であることだけを示し、心理的苦痛がないことや臨床診断を意味しません。",
          "suggestionText": "困りごとが続く場合は、専門職との面接や他の情報を併せて評価してください。",
          "reviewStatus": "DRAFT"
        },
        "en": {
          "resultTitle": "Below the screening cut point",
          "resultDescription": "The total is 0–12. This only indicates that the score is below the cut point used by this package; it does not mean no distress and is not a clinical diagnosis.",
          "suggestionText": "If distress continues, combine this result with a professional interview and other information.",
          "reviewStatus": "DRAFT"
        }
      }
    },
    {
      "ruleCode": "K6_AT_OR_ABOVE_CUTOFF",
      "riskLevel": "ATTENTION",
      "scoreMin": 13,
      "scoreMax": 24,
      "scoreSource": "RAW_SCORE",
      "translations": {
        "zh-CN": {
          "resultTitle": "达到筛查切点（需进一步评估）",
          "resultDescription": "总分为13–24。13+切点来自特定人群的筛查校准；它不是诊断，不能脱离适用人群和专业评估解释。",
          "suggestionText": "请由合格的专业人员结合适用人群、功能影响和安全风险进行进一步评估。",
          "reviewStatus": "DRAFT"
        },
        "ja-JP": {
          "resultTitle": "スクリーニングカットオフ以上（追加評価が必要）",
          "resultDescription": "合計得点は13～24です。13以上のカットオフは特定集団でのスクリーニング校正に基づくもので、診断ではなく、対象集団と専門的評価から切り離して解釈できません。",
          "suggestionText": "適用集団、生活機能への影響、安全上のリスクを踏まえ、資格のある専門職による追加評価を受けてください。",
          "reviewStatus": "DRAFT"
        },
        "en": {
          "resultTitle": "At or above the screening cut point (further assessment needed)",
          "resultDescription": "The total is 13–24. The 13+ cut point is calibrated for screening in a specific population; it is not a diagnosis and must not be interpreted apart from population scope and professional assessment.",
          "suggestionText": "A qualified professional should conduct further assessment considering population scope, functional impact and safety risk.",
          "reviewStatus": "DRAFT"
        }
      }
    }
  ],
