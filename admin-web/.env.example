# Build-time (Vite) configuration for the admin web app.
# Copy to `.env.local` (git ignored) or export the values in CI before
# `npm run build`; Vite inlines them into the bundle at build time, so changing
# them requires a rebuild.

# WeChat Official Account OAuth. Without an AppID the WeChat entry point shows
# an error instead of redirecting to the authorization page.
VITE_WECHAT_APP_ID=

# SSO entry points on the login page. Both default to hidden; set the matching
# value to "true" to render the button. The backend must also have the provider
# configured for the callback to succeed.
VITE_SSO_OIDC_ENABLED=false
VITE_SSO_CAS_ENABLED=false
